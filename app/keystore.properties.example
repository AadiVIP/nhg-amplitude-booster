# Release signing parameters for NHG Amplitude Booster.
#
# Copy this file OUTSIDE the repository, set 0600 permissions on it, fill in the
# real values and point Gradle at it:
#
#   export NHG_RELEASE_SIGNING_PROPERTIES=/home/you/.nhg-release/release.properties
#
# Keeping it next to app/ as "keystore.properties" also works - that name is
# git-ignored - but a path outside the working tree is harder to commit by
# accident. Never put real passwords in a file that is tracked, logged, or
# passed on a command line.

storeFile=/absolute/path/to/nhg-release.jks
storePassword=CHANGE_ME
keyAlias=nhg-release
keyPassword=CHANGE_ME
